<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Binacle.ViPaq\Binacle.ViPaq.csproj" />
    <ProjectReference Include="..\..\..\shared\src\Binacle.Geometry\Binacle.Geometry.csproj" />
    <ProjectReference Include="..\..\..\shared\src\Binacle.CompactNotation\Binacle.CompactNotation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protobuf\packing.proto" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Frozen placed-result data, generated offline by Binacle.ViPaq.PackedDataGenerator. Embedded so the data
      providers read the exact committed files with no lib dependency at run time. The "*.*.json" glob takes
      every algorithm — the inner dot is the ".ffd" / ".wfd" / ".bfd" suffix. Flat, no RecursiveDir, so the
      LogicalName stays "PackedData.<family>.<name>.<algo>.json", the four-part shape EmbeddedResourceFile
      splits on. Link keeps the out-of-project files under a virtual Data/ folder in the IDE. Rebuild after
      regenerating the data.
    -->
    <EmbeddedResource Include="..\..\data\packed\bischoff-suite\*.*.json">
      <Link>Data\bischoff-suite\%(Filename)%(Extension)</Link>
      <LogicalName>PackedData.bischoff-suite.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\data\packed\custom-problems\*.*.json">
      <Link>Data\custom-problems\%(Filename)%(Extension)</Link>
      <LogicalName>PackedData.custom-problems.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\data\packed\demo-samples\*.*.json">
      <Link>Data\demo-samples\%(Filename)%(Extension)</Link>
      <LogicalName>PackedData.demo-samples.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Binacle.Geometry" />
  </ItemGroup>

</Project>
