<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!--
        Frozen placed-result data, generated offline by Binacle.ViPaq.PackedDataGenerator into the sibling
        vipaq/data/packed folder, not a copy. The "*.*.json" glob takes every algorithm - the inner dot is the
        ".ffd" / ".wfd" / ".bfd" suffix. Flat, no RecursiveDir, so the LogicalName stays
        "PackedData.<family>.<name>.<algo>.json", the four-part shape PackedDataReader splits on. Rebuild after
        regenerating the data.
    -->
    <ItemGroup>
        <EmbeddedResource Include="..\packed\bischoff-suite\*.*.json">
            <Link>Packed\bischoff-suite\%(Filename)%(Extension)</Link>
            <LogicalName>PackedData.bischoff-suite.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="..\packed\custom-problems\*.*.json">
            <Link>Packed\custom-problems\%(Filename)%(Extension)</Link>
            <LogicalName>PackedData.custom-problems.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="..\packed\demo-samples\*.*.json">
            <Link>Packed\demo-samples\%(Filename)%(Extension)</Link>
            <LogicalName>PackedData.demo-samples.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\shared\data\Binacle.Data\Binacle.Data.csproj" />
        <ProjectReference Include="..\..\..\shared\src\Binacle.Geometry\Binacle.Geometry.csproj" />
        <ProjectReference Include="..\..\..\shared\src\Binacle.CompactNotation\Binacle.CompactNotation.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Binacle.Geometry" />
    </ItemGroup>

</Project>
