<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Xunit.Analyzers' MemberDataShouldReferenceValidMember crashes (raises AD0001, "Sequence contains
             no elements") on valid member data in xunit.v3 3.2.2, the latest, so there is nothing to upgrade
             to. It is an analyzer bug, not our code. AD0001 is raised by the analyzer driver and ignores
             editorconfig severity, so suppress it with NoWarn to stop it flooding every test build. -->
        <NoWarn>$(NoWarn);AD0001</NoWarn>
    </PropertyGroup>

    <!--
        Tell Sonar which projects are not product code. The Scanner for .NET spots a test project by a
        Microsoft.NET.Test.Sdk reference, and no project here has one - the MTP suites do not need it - so
        without this every project reads as product code: its lines count against coverage and the product
        rule set runs over it.

        Every project under a data/, test/, measure/, bench/ or tools/ folder is marked, the xunit suites
        included, so the layout decides it and nothing has to be listed.

        SonarQubeTestProject is read only by the scanner's targets, which are injected during a Sonar run and
        absent otherwise, so a normal build does not see this. Sonar still runs test-scope rules on these
        files: the [AssertionMethod] markers for S2699 stay load-bearing.
    -->
    <PropertyGroup>
        <!-- MSBuildProjectDirectory is separator-native, so normalise before matching or this misses on Linux. -->
        <_BinacleProjectPath>$(MSBuildProjectDirectory.Replace('\', '/'))</_BinacleProjectPath>
        <SonarQubeTestProject Condition="
            $(_BinacleProjectPath.Contains('/data/'))
            or $(_BinacleProjectPath.Contains('/test/'))
            or $(_BinacleProjectPath.Contains('/measure/'))
            or $(_BinacleProjectPath.Contains('/bench/'))
            or $(_BinacleProjectPath.Contains('/tools/'))
        ">true</SonarQubeTestProject>
    </PropertyGroup>
</Project>