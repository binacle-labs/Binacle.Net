@page "/vipaq"
@model VipaqModel
@{
	this.ViewData["Title"] = Model.Applet.Title;
}

<h1>@Model.Applet.Title</h1>

<p>@Model.Applet.Description</p>

@* `samples_panel` is registered in _js/protocol_decoder.js and nests under the decoder's scope, so it reads
   `samples`. *@
<div class="grid" x-data="protocol_decoder_app">
	<article class="no-padding s12 m5 l3 result-container" x-data="samples_panel" @@keyup.enter.prevent.stop="addResult">
		<article class="medium transparent result-input-container">
			<div class="field label textarea border max-height">
				<textarea name="result" id="result" x-model="model.result" class="word-wrap" placeholder=""></textarea>
				<label for="result">Add Result</label>
			</div>
		</article>
		<div>
			<nav class="no-space left-padding right-padding">
				<button type="button" class="border surface-container max" @@click.prevent.stop="addResult">
					<i>library_add</i>
				</button>
			</nav>
			<nav class="no-space left-padding right-padding bottom-padding">
				<button type="button" class="border surface-container max" @@click.prevent.stop="show()">
					<i>folder_open</i>
					<span>Samples</span>
				</button>
			</nav>
		</div>

		@* Known-good strings to copy into the input. No add button on purpose: the point is the string itself.
		   Same overlay-and-dialog shape as _ErrorsDialog. *@
		<div class="overlay" :class="open ? 'active' : ''" @@click.prevent.stop="hide()"></div>
		<dialog class="right medium" :class="open ? 'active' : ''">
			<h5>Samples</h5>
			<p>Each is the ViPaq string of a packed bin. Copy one and paste it into the input.</p>
			<template x-for="sample in samples" :key="sample.name">
				<article class="surface-container">
					<h6 class="small" x-text="sample.name"></h6>
					<pre class="small-text" style="white-space:pre-wrap;overflow-wrap:anywhere" x-text="sample.encoded"></pre>
					<nav class="right-align no-space">
						<button class="border surface-container" type="button" x-show="canCopy()" @@click.prevent.stop="copy(sample)">
							<i>content_copy</i>
							<span>Copy</span>
						</button>
					</nav>
				</article>
			</template>
			<nav class="right-align no-space">
				<button class="border surface-container" type="button" @@click.prevent.stop="hide()">
					<span>Close</span>
				</button>
			</nav>
		</dialog>
	</article>

	<div class="s12 m7 l9">
		<partial name="_PackingVisualizer"/>
	</div>

	<article class="s12 surface-variant">
		<fieldset class="scroll" style="block-size: 30rem;">
			<legend>Saved Results</legend>
			<template x-if="results.length <= 0">
				<span>No Results</span>
			</template>
			<template x-for="(result, index) in results" :key="index">
				<a class="row wave padding max"
				   :class="isSelected(result) ? 'surface-container border' : ''"
				   @@click.prevent.stop="selectResult(result)">
					<i class="large">package_2</i>
					<div class="grid no-space max">
						<span class="s4" x-text="resultTitle(result)"></span>
						<span class="s8 right-align" x-text="resultBinPercentageText(result)"></span>
						@* value="0" keeps the bar determinate - without it beercss animates a 0% result. Same
						   trap as the packing page, which carries the long version. *@
						<progress value="0" :value="result.packedBinVolumePercentage()" max="100"
						          class="s12 surface-container-lowest"></progress>
						<div class="s4" x-text="result.items.length + ' Items'"></div>
					</div>
					<button type="button" class="transparent circle" style="z-index:10" @@click.prevent.stop="deleteResult(result)">
						<i>delete</i>
					</button>
				</a>
			</template>
		</fieldset>
	</article>
</div>

<partial name="_ErrorsDialog"/>

@section Scripts {
	<partial name="_AppletScripts"/>
	<script src="/_content/Binacle.Net.UIModule/js/protocol_decoder.js"></script>
}
