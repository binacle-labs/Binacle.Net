@page "/error/{errorCode?}"
@model ErrorModel
@{
	ViewData["Title"] = Model.Title;
}

<section class="band">
	<div class="container band__grid">
		<div class="band__label"></div>
		<div class="band__body prose">
			<h1>@Model.Title</h1>
			<p>@Model.Message</p>
			<div class="actions">
				<a class="button" asp-page="/Index">Back to the home page</a>
			</div>
			@if (Model.RequestId is not null)
			{
				<p class="label">Request ID: <code>@Model.RequestId</code></p>
			}
		</div>
	</div>
</section>
