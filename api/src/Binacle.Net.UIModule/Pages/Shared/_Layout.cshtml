@inject IOptions<UIModuleOptions> UIModuleOptions
@{
	var defaultTheme = UIModuleOptions.Value.DefaultTheme;
	var stored = Context.Request.Cookies["theme"];
	var chosen = stored is "dark" or "light" ? stored : defaultTheme;
	// Read server-side, so the image needs no script in the head to avoid painting the wrong theme.
	// Null under "system", and Razor drops the whole attribute - no attribute is how the stylesheet is
	// told to follow the machine.
	string? theme = chosen is "dark" or "light" ? chosen : null;
}
<!DOCTYPE html>
<html lang="en" data-theme="@theme" data-default-theme="@defaultTheme" data-theme-storage="cookie">
<head>
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

	<title>@ViewData["Title"]</title>

	<link rel="preload" href="/_content/Binacle.Net.UIModule/fonts/familjen-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="preload" href="/_content/Binacle.Net.UIModule/fonts/martian-mono-latin.woff2" as="font" type="font/woff2" crossorigin>
	@* Compiled from _sass/ by `npm run build:css`. *@
	<link rel="stylesheet" href="/_content/Binacle.Net.UIModule/css/main.css"/>

	<link rel="icon" href="/_content/Binacle.Net.UIModule/favicon.ico"/>

	@await RenderSectionAsync("Head", required: false)
</head>
<body>

<partial name="_Header"/>

<main id="content">
	@RenderBody()
</main>

<partial name="_Footer"/>

@* runtime.js is webpack's, shared by every entry, so it loads here and nowhere else. *@
<script src="/_content/Binacle.Net.UIModule/js/runtime.js"></script>
<script src="/_content/Binacle.Net.UIModule/js/main.js"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
