@* The licence link is baked into every shipped image, so its address cannot move. *@
<footer class="site-footer site-footer--no-edge" data-site-footer>
	<div class="container">
		<p class="site-footer__line label">
			<span>(c) 2023-@DateTime.Now.Year Chris Mavrommatis</span>
			<span>Binacle.Net @Metadata.Version</span>
			<a class="site-footer__link" href="@($"{Metadata.GitHub}/blob/main/{Metadata.LicenseFile}")">@Metadata.LicenseId</a>
		</p>
		<p class="site-footer__line label">
			<a class="site-footer__link" href="@Metadata.Website">Binacle.Net</a>
			<a class="site-footer__link" href="@Metadata.Docs">Documentation</a>
			<a class="site-footer__link" href="@Metadata.Demo">Demo</a>
			<a class="site-footer__link site-footer__link--external" href="@Metadata.GitHub">GitHub</a>
			<a class="site-footer__link site-footer__link--external" href="@Metadata.Dockerhub">Docker Hub</a>
		</p>
	</div>
</footer>
