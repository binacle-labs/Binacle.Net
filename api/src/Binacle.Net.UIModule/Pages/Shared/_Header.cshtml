@inject AppletsService AppletsService
@{
	var currentPage = (string?)ViewContext.RouteData.Values["page"];
}

@* data-nav-row keeps the nav as one row that scrolls sideways on a phone, with no burger. *@
<header class="site-header" data-site-header data-nav-row>
	<div class="container">
		<a class="site-header__wordmark" asp-page="/Index"><img class="site-header__mark" src="/_content/Binacle.Net.UIModule/media/logo/binacle-logo.svg" alt="" width="24" height="24"><span>Binacle.Net</span></a>
		<nav class="site-header__nav" data-site-nav aria-label="Main">
			@foreach (var applet in AppletsService.Applets)
			{
				var current = string.Equals(currentPage, applet.Page, StringComparison.OrdinalIgnoreCase);
				<a class="site-header__link" asp-page="@applet.Page" aria-current="@(current ? "page" : null)">@applet.Title</a>
			}
		</nav>
		<theme-switcher data-button-class="theme-button"></theme-switcher>
	</div>
</header>
