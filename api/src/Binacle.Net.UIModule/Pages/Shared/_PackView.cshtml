@model string
@* Model is the line the view shows before there is anything to draw. *@
<figure class="pack-view" x-data="pack_view" x-on:update-scene.window="updateScene($event.detail)">
	<div class="pack-view__stage" data-pack-view-stage>
		<p class="pack-view__empty" data-pack-view-empty>@Model</p>
	</div>
	<figcaption class="pack-view__strip">
		<span class="dimension-line dimension-line--small dimension-line--strip" data-bin-dim hidden><span class="dimension-line__tick"></span><span class="dimension-line__number" data-bin-dim-number></span><span class="dimension-line__tick"></span></span>
		<span class="pack-view__status" data-placed></span>
	</figcaption>
	<div class="pack-view__controls" data-pack-view-controls aria-label="Placement order"></div>
</figure>
