<!-- Exists only so the Sonar scanner is offered the gem sources; NoTargets compiles nothing.

     Binacle.Net.slnx declares the rbproj extension, so this needs no Type attribute. It is based on C# and
     not on Shared: a Shared project is never built, IsBuildable="true" does not override that, and a project
     that is not built never reaches the scanner - which is this one's whole job. -->
<Project Sdk="Microsoft.Build.NoTargets/3.7.56">
    <PropertyGroup>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!-- vendor/ is the bundle CI installs, so without the exclude the build swallows every gem we depend on. -->
        <Content Include="**\*.rb" Exclude="vendor\**" />
    </ItemGroup>
</Project>
