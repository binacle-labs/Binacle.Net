<Project Sdk="Microsoft.Build.NoTargets/3.7.56">
    <PropertyGroup>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="*.json" />
        <Content Include="smoke\*.json" />
        <Content Include="cloudflare\*.jsonc" />
        <Content Include="**\*.sh" />
        <Content Include="**\*.py" />
        <Content Include="*.just"/>
        <Content Include="**\*.md"/>
        <Content Include="**\*.yml"/>
        <Content Include="**\*.yaml"/>
        <Content Include="**\*.hurl"/>
        <Content Include="**\*.xml"/>
        <Content Include="**\*.toml"/>
        <Content Include="**\*.rb"/>
    </ItemGroup>
</Project>