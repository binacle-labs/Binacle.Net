<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
      <IsPackable>false</IsPackable>

  </PropertyGroup>

    <!--
        Sourced from shared/data, not from copies. LogicalName reproduces the manifest name the reader expects;
        Link keeps the out-of-project files under a virtual folder in the IDE.
        One flat entry per folder, never a ** wildcard: %(RecursiveDir) injects a backslash into LogicalName
        and corrupts the manifest name.
    -->
    <ItemGroup>
        <EmbeddedResource Include="..\..\data\bischoff-suite\*.json">
            <Link>Algorithms\Data\BischoffSuite\%(Filename)%(Extension)</Link>
            <LogicalName>Binacle.TestsKernel.Algorithms.Data.BischoffSuite.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="..\..\data\custom-problems\*.json">
            <Link>Algorithms\Data\CustomProblems\%(Filename)%(Extension)</Link>
            <LogicalName>Binacle.TestsKernel.Algorithms.Data.CustomProblems.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="..\..\data\demo-samples\*.json">
            <Link>Algorithms\Data\DemoSamples\%(Filename)%(Extension)</Link>
            <LogicalName>Binacle.TestsKernel.Algorithms.Data.DemoSamples.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>


    <ItemGroup>
        <ProjectReference Include="..\..\src\Binacle.Packing\Binacle.Packing.csproj" />
        <ProjectReference Include="..\..\src\Binacle.CompactNotation\Binacle.CompactNotation.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Binacle.Geometry" />
        <Using Include="Binacle.Packing" />
    </ItemGroup>

</Project>
